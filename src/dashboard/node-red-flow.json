[
  {
    "id": "tab-dashboard",
    "type": "tab",
    "label": "CardioIA Dashboard",
    "disabled": false,
    "info": "Dashboard de monitoramento cardíaco - CardioIA Conectada - Grupo 15"
  },
  {
    "id": "mqtt-broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Cloud",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "node-red-cardioia",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "cardioia/sensores/status",
    "birthQos": "1",
    "birthRetain": "true",
    "birthPayload": "online",
    "closeTopic": "cardioia/sensores/status",
    "closeQos": "1",
    "closeRetain": "true",
    "closePayload": "offline",
    "willTopic": "cardioia/sensores/status",
    "willQos": "1",
    "willRetain": "true",
    "willPayload": "offline"
  },
  {
    "id": "mqtt-temperatura",
    "type": "mqtt in",
    "z": "tab-dashboard",
    "name": "Temperatura",
    "topic": "cardioia/sensores/temperatura",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 120,
    "y": 100,
    "wires": [["gauge-temp", "chart-temp"]]
  },
  {
    "id": "mqtt-umidade",
    "type": "mqtt in",
    "z": "tab-dashboard",
    "name": "Umidade",
    "topic": "cardioia/sensores/umidade",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 120,
    "y": 160,
    "wires": [["gauge-humid"]]
  },
  {
    "id": "mqtt-bpm",
    "type": "mqtt in",
    "z": "tab-dashboard",
    "name": "Batimentos (BPM)",
    "topic": "cardioia/sensores/bpm",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 120,
    "y": 220,
    "wires": [["function-bpm-check", "chart-bpm"]]
  },
  {
    "id": "mqtt-status",
    "type": "mqtt in",
    "z": "tab-dashboard",
    "name": "Status Sistema",
    "topic": "cardioia/sensores/status",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 120,
    "y": 280,
    "wires": [["text-status"]]
  },
  {
    "id": "gauge-temp",
    "type": "ui_gauge",
    "z": "tab-dashboard",
    "name": "Temperatura Corporal",
    "group": "dashboard-group",
    "order": 1,
    "width": "4",
    "height": "3",
    "gtype": "gage",
    "title": "Temperatura (°C)",
    "label": "°C",
    "format": "{{value}}",
    "min": 35,
    "max": 42,
    "colors": [
      {"color": "#00B050", "from": 35, "to": 37.5},
      {"color": "#FFC000", "from": 37.5, "to": 38},
      {"color": "#FF0000", "from": 38, "to": 42}
    ],
    "seg1": "Normal",
    "seg2": "Atenção",
    "seg3": "Febre",
    "x": 350,
    "y": 100,
    "wires": []
  },
  {
    "id": "gauge-humid",
    "type": "ui_gauge",
    "z": "tab-dashboard",
    "name": "Umidade Ambiente",
    "group": "dashboard-group",
    "order": 2,
    "width": "4",
    "height": "3",
    "gtype": "gage",
    "title": "Umidade (%)",
    "label": "%",
    "format": "{{value}}",
    "min": 20,
    "max": 100,
    "colors": [
      {"color": "#00B050", "from": 40, "to": 70},
      {"color": "#FFC000", "from": 30, "to": 40},
      {"color": "#FFC000", "from": 70, "to": 80},
      {"color": "#FF0000", "from": 20, "to": 30},
      {"color": "#FF0000", "from": 80, "to": 100}
    ],
    "seg1": "Ideal",
    "seg2": "Moderado",
    "seg3": "Extremo",
    "x": 350,
    "y": 160,
    "wires": []
  },
  {
    "id": "function-bpm-check",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Verificar BPM > 120",
    "func": "var bpm = Number(msg.payload);\nif (bpm > 120) {\n    node.warn(\"BPM elevado detectado: \" + bpm);\n    return { payload: \"ALERTA CRÍTICO\", topic: \"cardioia/alertas\" };\n} else if (bpm > 100) {\n    return { payload: \"ATENÇÃO - BPM: \" + bpm, topic: \"cardioia/alertas\" };\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 220,
    "wires": [["alert-led", "mqtt-out-alerta"]]
  },
  {
    "id": "chart-temp",
    "type": "ui_chart",
    "z": "tab-dashboard",
    "name": "Histórico Temperatura",
    "group": "charts-group",
    "order": 1,
    "width": "12",
    "height": "5",
    "label": "Temperatura (°C)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Aguardando dados...",
    "dot": false,
    "ymin": "35",
    "ymax": "42",
    "removeOlder": "1",
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#FF0000", "#00B050", "#0000FF"],
    "x": 650,
    "y": 100,
    "wires": [[], []]
  },
  {
    "id": "chart-bpm",
    "type": "ui_chart",
    "z": "tab-dashboard",
    "name": "Histórico Batimentos",
    "group": "charts-group",
    "order": 2,
    "width": "12",
    "height": "5",
    "label": "Batimentos/Minuto (BPM)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "step",
    "nodata": "Aguardando dados...",
    "dot": true,
    "ymin": "40",
    "ymax": "180",
    "removeOlder": "1",
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#1E90FF", "#FF4500", "#FF0000"],
    "x": 650,
    "y": 220,
    "wires": [[], []]
  },
  {
    "id": "alert-led",
    "type": "ui_text",
    "z": "tab-dashboard",
    "name": "Indicador de Alerta",
    "group": "dashboard-group",
    "order": 4,
    "width": "4",
    "height": "1",
    "label": "Status do Paciente",
    "format": "<div style='text-align:center; font-size:24px; color:{{msg.payload === \"ALERTA CRÍTICO\" ? \"red\" : \"orange\"}}; font-weight:bold;'>{{msg.payload}}</div>",
    "layout": "row-spread",
    "x": 350,
    "y": 300,
    "wires": []
  },
  {
    "id": "text-status",
    "type": "ui_text",
    "z": "tab-dashboard",
    "name": "Status Conexão",
    "group": "dashboard-group",
    "order": 3,
    "width": "4",
    "height": "1",
    "label": "Conexão ESP32",
    "format": "<div style='text-align:center; font-size:18px; color:{{msg.payload === \"online\" ? \"green\" : \"red\"}};'>● {{msg.payload | upper}}</div>",
    "layout": "row-spread",
    "x": 120,
    "y": 320,
    "wires": []
  },
  {
    "id": "mqtt-out-alerta",
    "type": "mqtt out",
    "z": "tab-dashboard",
    "name": "Alertas MQTT",
    "topic": "cardioia/alertas",
    "qos": "2",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt-broker",
    "x": 600,
    "y": 220,
    "wires": []
  },
  {
    "id": "dashboard-group",
    "type": "ui_group",
    "name": "Monitor Cardíaco",
    "tab": "ui-tab-cardioia",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "charts-group",
    "type": "ui_group",
    "name": "Históricos",
    "tab": "ui-tab-cardioia",
    "order": 2,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ui-tab-cardioia",
    "type": "ui_tab",
    "name": "CardioIA Conectada",
    "icon": "favorite",
    "order": 1,
    "disabled": false,
    "hidden": false
  }
]
