    { "type": "wokwi-resistor", "id": "r1", "top": -200, "left": -40, "rotate": 90, "attrs": { "resistance": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -140, "left": -40, "rotate": 90, "attrs": { "resistance": "220" } },
