    { "type": "wokwi-dht22", "id": "dht1", "top": -120, "left": 250, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 80, "left": 300, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led1", "top": -200, "left": -100, "attrs": { "color": "green" } },
